{
  "_version": "1.86.0",
  "sap.app": {
    "id": "btpconnections",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.30.0",
      "toolsId": "b6c4fa5c-e11a-401e-a70e-65926f0d5c8c"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/audit-logging-and-reporting/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "userauditreport-display": {
          "semanticObject": "",
          "action": "display",
          "title": "{{serviceconnection-display.flpTitle}}",
          "icon": "sap-icon://user-settings",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.151.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "btpconnections.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "BTPConnectionList",
          "target": "BTPConnectionList"
        },
        {
          "name": "BTPConnectionObjectPage",
          "pattern": "BTPConnection({BTPConnectionKey}):?query:",
          "target": "BTPConnectionObjectPage"
        }
      ],
      "targets": {
        "BTPConnectionList": {
          "type": "Component",
          "id": "BTPConnectionList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/BTPConnection",
              "variantManagement": "None",
              "navigation": {
                "BTPConnection": {
                  "detail": {
                    "route": "BTPConnectionObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "enableExport": true,
                    "selectAll": false,
                    "quickVariantSelection": {
                      "showCounts": true
                    },
                    "widthIncludingColumnHeader": true
                  }
                }
              },
              "initialLoad": "Enabled"
            }
          }
        },
        "BTPConnectionObjectPage": {
          "type": "Component",
          "id": "BTPConnectionObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "navigation": {},
              "contextPath": "/BTPConnection",
              "enableLazyLoading": true
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "auditreporting.app"
  }
}
